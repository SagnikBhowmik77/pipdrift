# Database. A file: URL runs SQLite locally; a postgres:// URL switches the
# driver automatically (src/lib/db.ts). Deployments must use Postgres — a
# serverless filesystem is ephemeral and a SQLite file loses every write on
# redeploy. See DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# Public origin, used to build links inside emails. Set this in production or
# reset links will point at localhost.
APP_URL="http://localhost:3100"

# Auth.js session signing key — generate with: openssl rand -base64 32
AUTH_SECRET=""

# ── Sentiment engine (all optional) ──────────────────────────────────────────
# Pipdrift labels headlines with the built-in lexicon unless you configure a
# model. Any OpenAI-compatible provider works — set all three:
#
#   Google Gemini  https://generativelanguage.googleapis.com/v1beta/openai
#   Groq           https://api.groq.com/openai/v1
#   OpenRouter     https://openrouter.ai/api/v1
#   Ollama (local) http://localhost:11434/v1     (leave LLM_API_KEY empty)
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Alternative: use Claude directly instead of the OpenAI-compatible path.
ANTHROPIC_API_KEY=""

# ── Outbound email (optional) ────────────────────────────────────────────────
# Password reset needs a way to send mail. With none of these set, the reset
# link is printed to the server console instead — which works for local use and
# self-hosting, and the UI says so rather than pretending mail was sent.
#
#   RESEND_API_KEY   https://resend.com — simplest, HTTP only, free tier
#   MAIL_WEBHOOK_URL POST the message anywhere (Zapier, n8n, your own relay)
RESEND_API_KEY=""
MAIL_WEBHOOK_URL=""
# Resend rejects unverified sender domains; its shared sandbox address works
# for testing.
MAIL_FROM="Pipdrift <onboarding@resend.dev>"

# Optional: override the headline feeds for /sandbox/signals and the agent tick.
# Comma-separated. Leave empty to use the five built-in Indian market feeds.
# PIPDRIFT_RSS_SOURCE names them positionally.
PIPDRIFT_RSS_URL=""
PIPDRIFT_RSS_SOURCE=""

# ── Error reporting (optional) ───────────────────────────────────────────────
# Where failures go. Unset, they are printed as single-line JSON, which log
# aggregators can parse. Set it and every report is POSTed there — Sentry,
# Slack, Discord, or your own endpoint.
ERROR_WEBHOOK_URL=""

# Shared secret the scheduler sends as: Authorization: Bearer <secret>
CRON_SECRET=""

# HMAC secret for POST /api/transactions/ingest (x-pipdrift-signature)
INGEST_SECRET=""
